# Frontend (Next.js) on Railway
# Set in Railway dashboard: Frontend Service → Environment Variables

# Backend API URL - Replace with your actual Railway backend service domain
NEXT_PUBLIC_API_BASE=https://your-backend-service.railway.app

# Node environment
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1

# Local development (when running locally with backend on :5000)
# NEXT_PUBLIC_API_BASE=http://localhost:5000

# Python bridge overrides (optional - for local CLI development only)
# PYTHON_EXE=..\.venv\Scripts\python.exe
# BRIDGE_SCRIPT=..\web_api_bridge.py

# AI assistant configuration (optional - if needed client-side)
# OPENAI_API_KEY=sk-...
